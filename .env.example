# ==========================================
# GS-AI-CLOUD GLOBAL CONFIGURATION
# ==========================================
DOMAIN=ai.yourdomain.com
ACME_EMAIL=admin@yourdomain.com
TZ=UTC
ENVIRONMENT=production

# Network Configuration
DOCKER_NETWORK=gs-ai-network

# ==========================================
# STACK 1: CORE
# ==========================================
TRAEFIK_DASHBOARD_HOST=traefik.ai.yourdomain.com
WATCHTOWER_POLL_INTERVAL=86400
PORTAINER_AGENT_SECRET=portainer_secret_token_change_me

# ==========================================
# STACK 2: DATABASE
# ==========================================
# PostgreSQL
POSTGRES_USER=gscloud
POSTGRES_PASSWORD=postgres_secure_password_change_me
POSTGRES_DB=gscloud
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=redis_secure_password_change_me
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secure_password_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_HOST=minio.ai.yourdomain.com

# Qdrant Vector DB
QDRANT_API_KEY=qdrant_secure_api_key_change_me
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ==========================================
# STACK 3: AI ENGINE & INFERENCE SERVERS
# ==========================================
# Ollama
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=24h

# LiteLLM Unified Proxy
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-gs-ai-cloud-master-key-change-me

# vLLM Engine
VLLM_PORT=8000
VLLM_MODEL=facebook/opt-125m

# SGLang Engine
SGLANG_PORT=30000
SGLANG_MODEL=meta-llama/Llama-2-7b-chat-hf

# Infinity Embedding Server
INFINITY_PORT=7997
INFINITY_MODEL=BAAI/bge-small-en-v1.5

# GPU Settings (nvidia/cpu)
NVIDIA_VISIBLE_DEVICES=all

# ==========================================
# STACK 4: AI APPLICATIONS
# ==========================================
# Open WebUI
OPEN_WEBUI_PORT=8080
WEBUI_SECRET_KEY=webui_secret_key_change_me

# LibreChat
LIBRECHAT_PORT=3080
LIBRECHAT_JWT_SECRET=librechat_jwt_secret_change_me
LIBRECHAT_CREDS_KEY=librechat_creds_key_32_chars_exact

# Flowise
FLOWISE_PORT=3001
FLOWISE_USERNAME=admin
FLOWISE_PASSWORD=flowise_admin_password_change_me

# Langflow
LANGFLOW_PORT=7860

# Dify
DIFY_PORT=8001
DIFY_SECRET_KEY=dify_secret_key_change_me

# n8n
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=n8n_admin_password_change_me
N8N_ENCRYPTION_KEY=n8n_encryption_key_change_me

# OpenHands (OpenDevin)
OPENHANDS_PORT=3000

# AnythingLLM
ANYTHINGLLM_PORT=3002
ANYTHINGLLM_JWT_SECRET=anythingllm_jwt_secret_change_me

# ==========================================
# STACK 5: AGENTS & CRAWLERS
# ==========================================
# Crawl4AI
CRAWL4AI_PORT=11235

# Firecrawl
FIRECRAWL_PORT=3003
FIRECRAWL_NUM_WORKERS=4

# Browser Use Service
BROWSER_USE_PORT=8082

# MCP Gateway
MCP_GATEWAY_PORT=8083

# OpenMemory Store
OPENMEMORY_PORT=8084

# Agent Orchestration (AutoGen / CrewAI Bridge)
AGENT_ORCHESTRATION_PORT=8085

# ==========================================
# STACK 6: MONITORING & LOGGING
# ==========================================
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_admin_password_change_me

LOKI_PORT=3100
PROMTAIL_PORT=9080
UPTIME_KUMA_PORT=3005
