# GS-AI-CLOUD production environment example
COMPOSE_PROJECT_NAME=gs-ai-cloud
TZ=UTC
DOMAIN=example.com
ACME_EMAIL=admin@example.com
LOG_LEVEL=INFO

# Docker image tags
POSTGRES_VERSION=16-alpine
REDIS_VERSION=7-alpine
MINIO_VERSION=RELEASE.2026-07-23T00-00-00Z
QDRANT_VERSION=latest
OLLAMA_VERSION=latest
LITELLM_VERSION=main-latest
VLLM_VERSION=latest
SGLANG_VERSION=latest
INFINITY_VERSION=latest

# Core auth and secrets: replace before production
POSTGRES_USER=gsai
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=gsai
REDIS_PASSWORD=change-me-redis
MINIO_ROOT_USER=gsaiadmin
MINIO_ROOT_PASSWORD=change-me-minio-32chars
LITELLM_MASTER_KEY=sk-change-me-litellm
OPENWEBUI_SECRET_KEY=change-me-openwebui
LIBRECHAT_JWT_SECRET=change-me-librechat-jwt
LIBRECHAT_JWT_REFRESH_SECRET=change-me-librechat-refresh
FLOWISE_USERNAME=admin
FLOWISE_PASSWORD=change-me-flowise
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=change-me-langflow
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
N8N_USER_MANAGEMENT_JWT_SECRET=change-me-n8n-jwt
DIFY_SECRET_KEY=change-me-dify
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# AI runtime settings
OLLAMA_MODELS=llama3.1:8b
OLLAMA_KEEP_ALIVE=24h
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
SGLANG_MODEL=Qwen/Qwen2.5-7B-Instruct
INFINITY_MODEL_ID=BAAI/bge-small-en-v1.5
CUDA_VISIBLE_DEVICES=all
GPU_COUNT=all

# Public routes
TRAEFIK_DASHBOARD_HOST=traefik.${DOMAIN}
PORTAINER_AGENT_HOST=portainer-agent.${DOMAIN}
MINIO_CONSOLE_HOST=minio.${DOMAIN}
OPENWEBUI_HOST=chat.${DOMAIN}
LIBRECHAT_HOST=librechat.${DOMAIN}
FLOWISE_HOST=flowise.${DOMAIN}
LANGFLOW_HOST=langflow.${DOMAIN}
DIFY_HOST=dify.${DOMAIN}
N8N_HOST=n8n.${DOMAIN}
ANYTHINGLLM_HOST=anythingllm.${DOMAIN}
OPENHANDS_HOST=openhands.${DOMAIN}
PROMETHEUS_HOST=prometheus.${DOMAIN}
GRAFANA_HOST=grafana.${DOMAIN}
KUMA_HOST=status.${DOMAIN}
